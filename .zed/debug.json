[
  {
    "adapter": "Debugpy",
    "label": "Run PackageChecker",
    "program": "${ZED_WORKTREE_ROOT}/main.py",
    "request": "launch",
    "args": [
      "-d",
      "${ZED_WORKTREE_ROOT}/_test_mods/",
      "-o",
      "${ZED_WORKTREE_ROOT}/_test_output/",
      "-s",
      "PACKAGE",
      "--write-report",
      "${ZED_WORKTREE_ROOT}/_test_output/report.txt",
      "--dont-write-skipped",
      // "--dry-run"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
  },
]
